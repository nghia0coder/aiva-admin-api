{
  "AppSettings": {
    "Serilog": {
      "MinimumLevel": {
        "Default": "Information",
        "Override": {
          "Microsoft": "Warning",
          "Microsoft.Hosting.Lifetime": "Information",
          "Microsoft.EntityFrameworkCore": "Warning"
        }
      },
      "WriteTo": [
        {
          "Name": "Console",
          "Args": {
            "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}      {Message:lj}{NewLine}{Exception}"
          }
        }
      ]
    },
    "AzureAI": {
      "Endpoint": "",
      "ApiKey": "",
      "DeploymentName": "gpt-4o-mini",
      "UseManagedIdentity": false,
      "MaxTokens": 2048,
      "Temperature": 0.7,
      "DefaultSystemPrompt": "You are a helpful AI assistant for the Aiva Admin system."
    },
    "Worker": {
      "Enabled": true,
      "PollingIntervalSeconds": 10,
      "BatchSize": 5,
      "MaxConcurrency": 3,
      "EnableEmbedding": true
    },
    "AzureBlobStorage": {
      "ServiceUri": "",
      "UseAzureIdentity": false,
      "DefaultAccessTier": "Hot"
    },
    "TextExtraction": {
      "UseAzureDocumentIntelligence": false,
      "MaxFileSizeBytes": 52428800,
      "MaxExtractedTextLength": 1000000,
      "TimeoutSeconds": 300
    }
  }
}